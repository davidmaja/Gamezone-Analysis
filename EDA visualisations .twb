            <column-instance column='[PRODUCT_NAME_cleaned]' derivation='None' name='[none:PRODUCT_NAME_cleaned:nk]' pivot='key' type='nominal' />
            <column-instance column='[USD_PRICE]' derivation='Sum' name='[sum:USD_PRICE:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Purchase_TS_cleaned]' derivation='Month-Trunc' name='[tmn:Purchase_TS_cleaned:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_129408151580876803]' derivation='User' name='[usr:Calculation_129408151580876803:qk]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' />
